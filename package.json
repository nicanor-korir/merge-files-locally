{
  "name": "merge-my-pdf-files-locally",
  "version": "1.0.0",
  "description": "i can't trust some files on online tools, building a simple local solution",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "build": "next build && node scripts/generate-sw.mjs",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "copy-pdf-worker": "node scripts/copy-pdf-worker.mjs",
    "generate-icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "next": "^15.3.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  }
}
